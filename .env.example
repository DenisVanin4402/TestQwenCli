# Local Spring configuration (KEY=value). No quotes, export or inline comments.
# Copy to .env; never commit real credentials.
GIGACHAT_MODE=none
# Authorization Key for OAuth (without the Basic prefix).
GIGACHAT_API_KEY=
# Not used by the client. The SDK obtains/refreshes access tokens in memory.
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CONNECT_TIMEOUT=5s
GIGACHAT_READ_TIMEOUT=30s
GIGACHAT_MAX_TOKENS=512
# Optional CA resource; use forward slashes on Windows.
# spring.ai.gigachat.auth.certs.ca-certs=file:C:/certs/ca.pem
