<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example</groupId>
        <artifactId>invest-pro</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>agent-main</artifactId>
    <packaging>jar</packaging>
    <properties>
        <poc.integration.tests>**/PocJarSmokeIT.java</poc.integration.tests>
        <gigachat.test.config>optional:classpath:/absent-test-env.properties</gigachat.test.config>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-api-in</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-api-out</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-ui-back</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.config.import>classpath:config/gigachat-prompts.yaml,optional:classpath:/absent-test-env.properties</spring.config.import>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <GIGACHAT_MODE>none</GIGACHAT_MODE>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Дочерние JVM тестов используют обычный classpath, а не структуру BOOT-INF. -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <systemPropertyVariables>
                        <spring.config.import>classpath:config/gigachat-prompts.yaml,${gigachat.test.config}</spring.config.import>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <GIGACHAT_MODE>none</GIGACHAT_MODE>
                    </environmentVariables>
                    <includes>
                        <include>${poc.integration.tests}</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-help-plugin</artifactId>
                <executions>
                    <execution>
                        <id>effective-stack</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>effective-pom</goal>
                        </goals>
                        <configuration>
                            <output>${project.build.directory}/effective-pom.xml</output>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolved-stack</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>tree</goal>
                        </goals>
                        <configuration>
                            <verbose>true</verbose>
                            <outputFile>${project.build.directory}/dependency-tree.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>gigachat-reference-eval</id>
            <properties>
                <poc.integration.tests>**/GigaChatReferenceEvaluation.java</poc.integration.tests>
                <gigachat.test.config>file:${maven.multiModuleProjectDirectory}/.env[.properties]</gigachat.test.config>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration><skipTests>false</skipTests></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>gigachat-classification-eval</id>
            <properties>
                <poc.integration.tests>**/GigaChatClassificationEvaluation.java</poc.integration.tests>
                <gigachat.test.config>file:${maven.multiModuleProjectDirectory}/.env[.properties]</gigachat.test.config>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration><skipTests>false</skipTests></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>gigachat-smoke</id>
            <properties>
                <poc.integration.tests>**/GigaChatLiveSmoke.java</poc.integration.tests>
                <gigachat.test.config>file:${maven.multiModuleProjectDirectory}/.env[.properties]</gigachat.test.config>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Позволяет отдельно выполнить live smoke после обычного verify с -DskipTests. -->
                            <skipTests>false</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-tests</id>
            <properties>
                <poc.integration.tests>**/*IT.java</poc.integration.tests>
            </properties>
        </profile>
    </profiles>
</project>
