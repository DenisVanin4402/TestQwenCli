@startuml
autonumber
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam SequenceActorStyle handsome

actor "Пользователь" as User
participant "Маршрутизатор" as Router
participant "Агент по платежам" as PayAgent
participant "Агент по переписке" as ChatAgent
participant "Модуль проверки полномочий" as AuthModule
participant "Invest corr" as InvestCorr

== Поток 1. Клик по зацепке ==
activate User
User -> Router: Клик по зацепке
activate Router
Router -> PayAgent: Вызвать агента по платежам\n(данные зацепки)
activate PayAgent
PayAgent -> PayAgent: Обработка запроса
PayAgent --> Router: Текст ответа + suggest\n(с типом запроса, данными платежа и epkId)
deactivate PayAgent
note over PayAgent: Линия жизни агента по платежам\nна этом завершается
Router --> User: Текст ответа + suggest

== Поток 2. Клик по suggest ==
User -> Router: Клик по suggest
Router -> ChatAgent: Запрос с данными платежа,\nтекстом suggest и epkId
activate ChatAgent
deactivate Router

alt Тип запроса: статус
    note over ChatAgent: Проверка полномочий не требуется
    ChatAgent --> User: "Вы хотите отправить запрос\n"статус"\nпо платежу\n"данные платежа, полученные от агента по платежам"\nот "данные организации из данных платежа""

    alt Подтверждение
        User -> ChatAgent: Подтверждение
        ChatAgent -> InvestCorr: Вызов модуля Invest corr
        activate InvestCorr
        InvestCorr -> InvestCorr: Обработка запроса
        InvestCorr --> ChatAgent: Запрос принят в обработку
        deactivate InvestCorr
        ChatAgent --> User: "Ваш запрос принят в обработку\nо результатах узнаете в СМС от номера 900"
    else Ввод текста или suggest
        User -> ChatAgent: Ввод текста или suggest
        note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
    end

else Тип запроса: отзыв
    ChatAgent -> AuthModule: Проверка полномочий\nна операцию "отзыв"
    activate AuthModule
    AuthModule -> AuthModule: Проверка прав пользователя\nпо платежу
    AuthModule --> ChatAgent: Результат проверки полномочий
    deactivate AuthModule

    alt Операция доступна
        ChatAgent --> User: "Вы хотите отправить запрос\n"отзыв"\nпо платежу\n"данные платежа, полученные от агента по платежам"\nот "данные организации из данных платежа""

        alt Подтверждение
            User -> ChatAgent: Подтверждение
            ChatAgent -> InvestCorr: Вызов модуля Invest corr
            activate InvestCorr
            InvestCorr -> InvestCorr: Обработка запроса
            InvestCorr --> ChatAgent: Запрос принят в обработку
            deactivate InvestCorr
            ChatAgent --> User: "Ваш запрос принят в обработку\nо результатах узнаете в СМС от номера 900"
        else Ввод текста или suggest
            User -> ChatAgent: Ввод текста или suggest
            note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
        end

    else Операция недоступна
        ChatAgent --> User: "Вам доступен только запрос на статус" + suggest
        alt Пользователь выбрал suggest (статус)
            note over User, ChatAgent: Переход к сценарию "статус"
        else Ввод текста или suggest
            User -> ChatAgent: Ввод текста или suggest
            note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
        end
    end

else Тип запроса: уточнение реквизитов
    ChatAgent -> AuthModule: Проверка полномочий\nна операцию "уточнение реквизитов"
    activate AuthModule
    AuthModule -> AuthModule: Проверка прав пользователя\nпо платежу
    AuthModule --> ChatAgent: Результат проверки полномочий
    deactivate AuthModule

    alt Операция доступна
        ChatAgent --> User: "Введите реквизиты, которые необходимо уточнить.\nДоступные реквизиты:\n- ИНН получателя\n- номер счета получателя\n- Наименование получателя\n- Назначение платежа"

        alt Ввод реквизитов
            User -> ChatAgent: Ввод реквизитов для уточнения
            ChatAgent -> ChatAgent: Проверка ФЛК введённых реквизитов

            alt ФЛК пройдено
                ChatAgent --> User: "Вы хотите отправить запрос\n"на уточнение реквизитов"\nпо платежу\n"данные платежа, полученные от агента по платежам""\n"Список уточняемых реквизитов""

                alt Подтверждение
                    User -> ChatAgent: Подтверждение
                    ChatAgent -> InvestCorr: Вызов модуля Invest corr
                    activate InvestCorr
                    InvestCorr -> InvestCorr: Обработка запроса
                    InvestCorr --> ChatAgent: Запрос принят в обработку
                    deactivate InvestCorr
                    ChatAgent --> User: "Ваш запрос принят в обработку\nо результатах узнаете в СМС от номера 900"
                else Ввод текста или suggest
                    User -> ChatAgent: Ввод текста или suggest
                    note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
                end

            else ФЛК не пройдено
                ChatAgent --> User: "ИНН должен быть 10 или 12 символов.\nВведите ваши данные ещё раз"
                User -> ChatAgent: Повторный ввод реквизитов
                note over ChatAgent: Возврат к проверке ФЛК\nвведённых реквизитов
            end

        else Ввод текста или suggest
            User -> ChatAgent: Ввод текста или suggest
            note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
        end

    else Операция недоступна
        ChatAgent --> User: "Вам доступен только запрос на статус" + suggest
        alt Пользователь выбрал suggest (статус)
            note over User, ChatAgent: Переход к сценарию "статус"
        else Ввод текста или suggest
            User -> ChatAgent: Ввод текста или suggest
            note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
        end
    end

else Пользователь не согласился ни с одним вариантом
    User -> ChatAgent: Отказ пользователя\n(ни статус/отзыв, ни уточнение реквизитов)
    ChatAgent --> User: "Я могу помочь отправить запрос в банк\nпо платежу "данные платежа от агента по платежам"" + suggest
    User -> ChatAgent: Ввод текста или suggest
    note over ChatAgent: Единый обработчик:\nвозврат к сценарию выбора типа запроса
end
deactivate ChatAgent
deactivate User
@enduml