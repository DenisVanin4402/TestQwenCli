{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "system",
    "baseline",
    "documents"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "primaryFormat": {
      "const": "markdown"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "path",
          "parent",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "overview",
              "capability",
              "domain",
              "reference",
              "algorithm",
              "workflow",
              "rules",
              "states",
              "permissions",
              "acceptance",
              "decisions",
              "questions"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]+-[0-9]{3,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "audience": {
            "enum": [
              "reader",
              "evidence"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "in_review",
              "approved",
              "superseded"
            ]
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "approvedBy",
                "approvedAt"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "purpose"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
