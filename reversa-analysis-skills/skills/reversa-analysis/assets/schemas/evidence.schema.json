{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "sources",
    "claims",
    "questions"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "locator",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "code",
              "reversa",
              "decision",
              "test",
              "documentation",
              "synthetic"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "documentId",
          "text",
          "kind",
          "basis",
          "sourceIds",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "documentId": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "observed",
              "required",
              "proposed"
            ]
          },
          "basis": {
            "enum": [
              "direct",
              "inferred",
              "unknown"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3,}$"
            }
          },
          "questionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3,}$"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "in_review",
              "approved",
              "superseded"
            ]
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "approvedBy",
                "approvedAt"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "inferred"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "rationale"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "unknown"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "questionIds"
              ],
              "properties": {
                "questionIds": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "sourceIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "documentIds",
          "text",
          "severity",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "documentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3,}$"
            },
            "minItems": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "accepted_gap"
            ]
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "answered"
                }
              }
            },
            "then": {
              "required": [
                "answer"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "accepted_gap"
                }
              }
            },
            "then": {
              "required": [
                "acceptance"
              ]
            }
          }
        ]
      }
    }
  }
}
